table fact_results
	lineageTag: 2fdb5f8d-437d-5587-9bd4-da54b6fd91fa

	measure 'Avg Value' = AVERAGE ( fact_results[value] )
		formatString: #,0.##
		lineageTag: c73298f7-920e-5ccc-b34d-9dad211cd5b2

	measure 'Avg Value per 250h' = AVERAGE ( fact_results[value_per_250h] )
		formatString: #,0.0
		lineageTag: 70244e02-8bc2-5d4f-b808-fef469bd2072

	measure 'Latest Value' = ```
			VAR PeriodEnd = [Report Date]
			VAR LatestDate =
			    CALCULATE ( MAX ( fact_results[sample_date] ), REMOVEFILTERS ( 'Date' ), fact_results[sample_date] <= PeriodEnd )
			RETURN
			    CALCULATE ( AVERAGE ( fact_results[value] ), REMOVEFILTERS ( 'Date' ), fact_results[sample_date] = LatestDate )
			```
		formatString: #,0.##
		lineageTag: 23940f18-4f89-50eb-a182-be4478ee8742

	measure 'Caution Limit' = MAX ( dim_test[caution_high] )
		formatString: #,0.##
		lineageTag: 280633d5-bb6e-5467-940d-f0a3160e4dde

	measure 'Critical Limit' = MAX ( dim_test[critical_high] )
		formatString: #,0.##
		lineageTag: 90fbab35-a3e0-581e-ab84-e64463979861

	measure 'Latest vs Caution %' = DIVIDE ( [Latest Value], [Caution Limit] )
		formatString: 0%
		lineageTag: d701507c-7100-57ad-8bb7-163c4a766fd5

	measure 'Health Value' = IF ( SELECTEDVALUE ( dim_test[test] ) IN { "Fe", "Cu", "Pb", "Al", "Si", "Na", "K", "FUEL", "SOOT" }, [Latest Value] )
		formatString: #,0.##
		lineageTag: cc3a4613-b637-5c93-8c4f-790e1254e96a

	measure 'Health Cell Background' = ```
			VAR v = [Latest Value]
			VAR caution = MAX ( dim_test[caution_high] )
			VAR critical = MAX ( dim_test[critical_high] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( v ) || ISBLANK ( caution ), BLANK (),
			        v >= critical, "#D03B3B",
			        v >= caution, "#EC835A",
			        v >= 0.7 * caution, "#FDE7A9",
			        "#E8F5EA"
			    )
			```
		lineageTag: 937e40db-7524-524e-99b5-4b848c398340

	measure 'Health Cell Font' = ```
			VAR v = [Latest Value]
			VAR caution = MAX ( dim_test[caution_high] )
			RETURN IF ( NOT ISBLANK ( caution ) && v >= caution, "#FFFFFF", "#1B2B3F" )
			```
		lineageTag: e80e5c7e-cf47-56aa-8da5-5c39fa523c80

	measure 'Result Status Colour' = SWITCH ( SELECTEDVALUE ( fact_results[limit_status] ), "Critical", "#D03B3B", "Caution", "#EC835A", "Normal", "#0CA30C", "#8A97A8" )
		lineageTag: 02fe77c3-e7b2-5f8f-b83a-96ec73c008be

	measure 'Trend Title' = "Trend: " & SELECTEDVALUE ( dim_test[description], "select one test" ) & " (" & SELECTEDVALUE ( dim_test[unit] ) & ")"
		lineageTag: eff9ebc0-a4fe-5f9d-b55e-5e1751daea34

	measure 'Flagged Results' = ```
			CALCULATE (
			    COUNTROWS ( fact_results ),
			    fact_results[anomaly] <> "" || fact_results[limit_status] IN { "Caution", "Critical" }
			)
			```
		formatString: 0
		lineageTag: d31c4eab-baa4-55ff-afa9-ff429be3c554

