	column unit_baseline
		dataType: double
		formatString: #,0.0
		lineageTag: 88654126-8232-58ab-ad79-22debe11e3d7
		summarizeBy: none
		sourceColumn: unit_baseline

		annotation SummarizationSetBy = User

	partition fact_results = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_results.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"sample_id", type text}, {"test", type text}, {"value", type number}, {"unit", type text}, {"unit_id", type text}, {"sample_date", type date}, {"limit_status", type text}, {"value_per_250h", type number}, {"anomaly", type text}, {"z", type number}, {"unit_baseline", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
