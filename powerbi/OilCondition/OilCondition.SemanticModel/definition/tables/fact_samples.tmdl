	column 'Status Order'
		dataType: int64
		formatString: 0
		lineageTag: 3bd2cc10-f38f-533b-94df-9d007d68ccaf
		summarizeBy: none
		sourceColumn: Status Order
		isHidden

		annotation SummarizationSetBy = User

	partition fact_samples = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_samples.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"sample_id", type text}, {"unit_id", type text}, {"sample_date", type date}, {"sample_date_quality", type text}, {"received_at", type date}, {"reported_at", type date}, {"unit_hours", Int64.Type}, {"oil_hours", type number}, {"oil_changed", type text}, {"lab_status", type text}, {"status", type text}, {"attention_tests", type text}, {"diagnosis", type text}, {"recommendation", type text}, {"isolated_spike", type text}}, "en-US"),
				    Added0 = Table.AddColumn(Typed, "Status Order", each if [status] = "Normal" then 1 else if [status] = "Watch" then 2 else if [status] = "Caution" then 3 else if [status] = "Critical" then 4 else 5, Int64.Type)
				in
				    Added0

	annotation PBI_ResultType = Table
