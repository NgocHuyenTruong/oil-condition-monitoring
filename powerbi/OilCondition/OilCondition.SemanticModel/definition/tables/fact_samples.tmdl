table fact_samples
	lineageTag: 8bad378d-5d69-5977-a22b-24843b564cec

	measure Samples = DISTINCTCOUNT ( fact_samples[sample_id] )
		formatString: 0
		lineageTag: 59103a18-50fa-5fa4-868f-39e5353a1bc4

	measure 'Units Sampled' = DISTINCTCOUNT ( fact_samples[unit_id] )
		formatString: 0
		lineageTag: 495a72c4-2631-5248-9f59-ce4da7445a73

	measure 'Samples Critical' = CALCULATE ( [Samples], fact_samples[status] = "Critical" )
		formatString: 0
		lineageTag: 21d3b0a0-eb4f-520d-89aa-0f1a7d3b2f83

	measure 'Samples Caution' = CALCULATE ( [Samples], fact_samples[status] = "Caution" )
		formatString: 0
		lineageTag: f47bbadf-3775-5106-bb35-8779202e6f51

	measure 'Samples Watch' = CALCULATE ( [Samples], fact_samples[status] = "Watch" )
		formatString: 0
		lineageTag: 493464e3-3603-567e-81d7-c17825437c62

	measure '% Samples Needing Action' = DIVIDE ( CALCULATE ( [Samples], fact_samples[status] IN { "Caution", "Critical" } ), [Samples] )
		formatString: 0.0%
		lineageTag: aa34c3ba-efe0-555a-aad5-22d14c45ed89

	measure 'Report Date' = ```
			VAR PeriodEnd = MAX ( 'Date'[Date] )
			VAR LastData = CALCULATE ( MAX ( fact_samples[sample_date] ), REMOVEFILTERS () )
			RETURN MIN ( PeriodEnd, LastData )
			```
		formatString: dd mmm yyyy
		lineageTag: 3a489532-3598-5846-98b1-a0a23f02ec4c

	measure 'Latest Sample Date' = ```
			VAR PeriodEnd = [Report Date]
			RETURN
			    CALCULATE (
			        MAX ( fact_samples[sample_date] ),
			        REMOVEFILTERS ( 'Date' ),
			        fact_samples[sample_date] <= PeriodEnd
			    )
			```
		formatString: dd mmm yyyy
		lineageTag: 33b0c057-9fc4-5ef8-b773-1d35fcdd372a

	measure 'Latest Status' = ```
			VAR LatestDate = [Latest Sample Date]
			RETURN
			    CALCULATE (
			        SELECTEDVALUE ( fact_samples[status] ),
			        REMOVEFILTERS ( 'Date' ),
			        fact_samples[sample_date] = LatestDate
			    )
			```
		lineageTag: 620799ab-e6b6-5431-9f5d-61a66fe3b483

	measure 'Latest Diagnosis' = ```
			VAR LatestDate = [Latest Sample Date]
			RETURN
			    CALCULATE (
			        SELECTEDVALUE ( fact_samples[diagnosis] ),
			        REMOVEFILTERS ( 'Date' ),
			        fact_samples[sample_date] = LatestDate
			    )
			```
		lineageTag: c9d26ae4-86b1-5f7f-aea6-b83675564123

	measure 'Latest Recommendation' = ```
			VAR LatestDate = [Latest Sample Date]
			RETURN
			    CALCULATE (
			        SELECTEDVALUE ( fact_samples[recommendation] ),
			        REMOVEFILTERS ( 'Date' ),
			        fact_samples[sample_date] = LatestDate
			    )
			```
		lineageTag: d3ac8510-ae7f-5bf7-957c-110cc607126a

	measure 'Units Needing Action' = COUNTROWS ( FILTER ( VALUES ( dim_unit[unit_id] ), [Latest Status] IN { "Caution", "Critical" } ) ) + 0
		formatString: 0
		lineageTag: eb91d69d-fbaf-52e0-84dc-445d71212c5e

	measure 'Units on Watch' = COUNTROWS ( FILTER ( VALUES ( dim_unit[unit_id] ), [Latest Status] = "Watch" ) ) + 0
		formatString: 0
		lineageTag: 146f7b38-c319-547e-aa2b-c403ee93e1e2

	measure 'Days Since Last Sample' = ```
			VAR LatestDate = [Latest Sample Date]
			RETURN IF ( NOT ISBLANK ( LatestDate ), INT ( [Report Date] - LatestDate ) )
			```
		formatString: 0
		lineageTag: 313724ec-7e61-5f35-a749-6e0b30462efa

	measure 'Overdue Units' = COUNTROWS ( FILTER ( VALUES ( dim_unit[unit_id] ), [Days Since Last Sample] > 30 ) ) + 0
		formatString: 0
		lineageTag: 96fadd1b-18de-5742-af1d-44d5bc5cf4af

	measure 'Units Sampled Label' = FORMAT ( [Units Sampled] + 0, "0" ) & " / " & FORMAT ( COUNTROWS ( dim_unit ), "0" )
		lineageTag: 2f1f1022-3cfa-573e-a05d-966e8a64bfe0

	measure 'Latest Status Label' = ```
			SWITCH (
			    [Latest Status],
			    "Critical", UNICHAR ( 9632 ) & " Critical",
			    "Caution", UNICHAR ( 9650 ) & " Caution",
			    "Watch", UNICHAR ( 9679 ) & " Watch",
			    "Normal", UNICHAR ( 10003 ) & " Normal"
			)
			```
		lineageTag: 7b2e86c9-3725-5047-98c5-efb3d4d8323d

	measure 'Latest Status Colour' = SWITCH ( [Latest Status], "Critical", "#D03B3B", "Caution", "#EC835A", "Watch", "#FAB219", "Normal", "#0CA30C", "#8A97A8" )
		lineageTag: d950d18b-7412-56ef-b99b-2c903c38975a

	measure 'Action Status' = IF ( [Latest Status] IN { "Caution", "Critical" }, [Latest Status Label] )
		lineageTag: 11bf7a4d-616c-5af1-b00c-d5d82164a0cc

	measure 'Action Last Sample' = IF ( [Latest Status] IN { "Caution", "Critical" }, [Latest Sample Date] )
		formatString: dd mmm
		lineageTag: db0cab03-eab3-56b6-8f7c-38531f390c97

	measure 'Action Likely Cause' = IF ( [Latest Status] IN { "Caution", "Critical" }, SUBSTITUTE ( [Latest Diagnosis], "Possible ", "" ) )
		lineageTag: 08a559a5-d2a0-5003-9a73-8d5ef71453a7

