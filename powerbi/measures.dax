// DAX measures used by the Power BI report. Generated by powerbi/build_pbip.py: edit there, not here.
// Tables: fact_samples, fact_results, dim_unit, dim_test, dq_issues, quarantine, Date.

// ======================= Date table (Modeling > New table) =======================
Date =
ADDCOLUMNS (
    CALENDAR (
        DATE ( YEAR ( MIN ( fact_samples[sample_date] ) ), 1, 1 ),
        DATE ( YEAR ( MAX ( fact_samples[sample_date] ) ), 12, 31 )
    ),
    "Month", FORMAT ( [Date], "yyyy-mm" ),
    "Month Name", FORMAT ( [Date], "mmm yyyy" ),
    "Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 )
)

// ======================= Samples (home table: fact_samples) =======================
Samples = DISTINCTCOUNT ( fact_samples[sample_id] )

Units Sampled = DISTINCTCOUNT ( fact_samples[unit_id] )

Samples Critical = CALCULATE ( [Samples], fact_samples[status] = "Critical" )

Samples Caution = CALCULATE ( [Samples], fact_samples[status] = "Caution" )

Samples Watch = CALCULATE ( [Samples], fact_samples[status] = "Watch" )

% Samples Needing Action = DIVIDE ( CALCULATE ( [Samples], fact_samples[status] IN { "Caution", "Critical" } ), [Samples] )

// ======================= Fleet status as at the end of the selected period (home table: fact_samples) =======================
// End of the selected period, but never later than the newest sample in the data
Report Date =
VAR PeriodEnd = MAX ( 'Date'[Date] )
VAR LastData = CALCULATE ( MAX ( fact_samples[sample_date] ), REMOVEFILTERS () )
RETURN MIN ( PeriodEnd, LastData )

// Looks back past the slicer so a unit sampled last month still shows its latest status
Latest Sample Date =
VAR PeriodEnd = [Report Date]
RETURN
    CALCULATE (
        MAX ( fact_samples[sample_date] ),
        REMOVEFILTERS ( 'Date' ),
        fact_samples[sample_date] <= PeriodEnd
    )

Latest Status =
VAR LatestDate = [Latest Sample Date]
RETURN
    CALCULATE (
        SELECTEDVALUE ( fact_samples[status] ),
        REMOVEFILTERS ( 'Date' ),
        fact_samples[sample_date] = LatestDate
    )

Latest Diagnosis =
VAR LatestDate = [Latest Sample Date]
RETURN
    CALCULATE (
        SELECTEDVALUE ( fact_samples[diagnosis] ),
        REMOVEFILTERS ( 'Date' ),
        fact_samples[sample_date] = LatestDate
    )

Latest Recommendation =
VAR LatestDate = [Latest Sample Date]
RETURN
    CALCULATE (
        SELECTEDVALUE ( fact_samples[recommendation] ),
        REMOVEFILTERS ( 'Date' ),
        fact_samples[sample_date] = LatestDate
    )

Units Needing Action = COUNTROWS ( FILTER ( VALUES ( dim_unit[unit_id] ), [Latest Status] IN { "Caution", "Critical" } ) ) + 0

Units on Watch = COUNTROWS ( FILTER ( VALUES ( dim_unit[unit_id] ), [Latest Status] = "Watch" ) ) + 0

Days Since Last Sample =
VAR LatestDate = [Latest Sample Date]
RETURN IF ( NOT ISBLANK ( LatestDate ), INT ( [Report Date] - LatestDate ) )

Overdue Units = COUNTROWS ( FILTER ( VALUES ( dim_unit[unit_id] ), [Days Since Last Sample] > 30 ) ) + 0

Units Sampled Label = FORMAT ( [Units Sampled] + 0, "0" ) & " / " & FORMAT ( COUNTROWS ( dim_unit ), "0" )

// Status text with a symbol, so status is never shown by colour alone
Latest Status Label =
SWITCH (
    [Latest Status],
    "Critical", UNICHAR ( 9632 ) & " Critical",
    "Caution", UNICHAR ( 9650 ) & " Caution",
    "Watch", UNICHAR ( 9679 ) & " Watch",
    "Normal", UNICHAR ( 10003 ) & " Normal"
)

// Font colour > fx > Field value
Latest Status Colour = SWITCH ( [Latest Status], "Critical", "#D03B3B", "Caution", "#EC835A", "Watch", "#FAB219", "Normal", "#0CA30C", "#8A97A8" )

// ======================= Units needing attention table (blank for other units, so their rows disappear) (home table: fact_samples) =======================
Action Status = IF ( [Latest Status] IN { "Caution", "Critical" }, [Latest Status Label] )

Action Last Sample = IF ( [Latest Status] IN { "Caution", "Critical" }, [Latest Sample Date] )

Action Likely Cause = IF ( [Latest Status] IN { "Caution", "Critical" }, SUBSTITUTE ( [Latest Diagnosis], "Possible ", "" ) )

// ======================= Results (use with dim_test[test] on rows, legend or a slicer) (home table: fact_results) =======================
Avg Value = AVERAGE ( fact_results[value] )

// Accumulative tests scaled to 250 oil hours: the line to trend, since raw values zig-zag with oil age
Avg Value per 250h = AVERAGE ( fact_results[value_per_250h] )

// Latest result on or before the end of the selected period
Latest Value =
VAR PeriodEnd = [Report Date]
VAR LatestDate =
    CALCULATE ( MAX ( fact_results[sample_date] ), REMOVEFILTERS ( 'Date' ), fact_results[sample_date] <= PeriodEnd )
RETURN
    CALCULATE ( AVERAGE ( fact_results[value] ), REMOVEFILTERS ( 'Date' ), fact_results[sample_date] = LatestDate )

Caution Limit = MAX ( dim_test[caution_high] )

Critical Limit = MAX ( dim_test[critical_high] )

Latest vs Caution % = DIVIDE ( [Latest Value], [Caution Limit] )

// Fleet health matrix: only the tests shown there (other test columns stay empty and are hidden)
Health Value = IF ( SELECTEDVALUE ( dim_test[test] ) IN { "Fe", "Cu", "Pb", "Al", "Si", "Na", "K", "FUEL", "SOOT" }, [Latest Value] )

// Background colour > fx > Field value
Health Cell Background =
VAR v = [Latest Value]
VAR caution = MAX ( dim_test[caution_high] )
VAR critical = MAX ( dim_test[critical_high] )
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( v ) || ISBLANK ( caution ), BLANK (),
        v >= critical, "#D03B3B",
        v >= caution, "#EC835A",
        v >= 0.7 * caution, "#FDE7A9",
        "#E8F5EA"
    )

Health Cell Font =
VAR v = [Latest Value]
VAR caution = MAX ( dim_test[caution_high] )
RETURN IF ( NOT ISBLANK ( caution ) && v >= caution, "#FFFFFF", "#1B2B3F" )

Result Status Colour = SWITCH ( SELECTEDVALUE ( fact_results[limit_status] ), "Critical", "#D03B3B", "Caution", "#EC835A", "Normal", "#0CA30C", "#8A97A8" )

Trend Title = "Trend: " & SELECTEDVALUE ( dim_test[description], "select one test" ) & " (" & SELECTEDVALUE ( dim_test[unit] ) & ")"

Flagged Results =
CALCULATE (
    COUNTROWS ( fact_results ),
    fact_results[anomaly] <> "" || fact_results[limit_status] IN { "Caution", "Critical" }
)

// ======================= Data quality (home table: dq_issues) =======================
DQ Issues = COUNTROWS ( dq_issues )

// Leaves out records that never got a sample date (quarantined)
DQ Issues by Month = CALCULATE ( [DQ Issues], KEEPFILTERS ( NOT ISBLANK ( 'Date'[Month Name] ) ) )

DQ Auto-fixed = CALCULATE ( [DQ Issues], dq_issues[action] IN { "corrected", "imputed", "dropped" } )

DQ Needing Follow-up = CALCULATE ( [DQ Issues], dq_issues[action] IN { "flagged", "quarantined", "removed value" } )

DQ Quarantined = CALCULATE ( [DQ Issues], dq_issues[action] = "quarantined" )

% Samples Clean = 1 - DIVIDE ( CALCULATE ( DISTINCTCOUNT ( dq_issues[sample_id] ), dq_issues[action] <> "dropped" ), [Samples] )

// ======================= Calculated columns (Table tools > New column) =======================
// in dim_unit
Current Status =
VAR LatestDate = CALCULATE ( MAX ( fact_samples[sample_date] ) )
RETURN CALCULATE ( SELECTEDVALUE ( fact_samples[status] ), fact_samples[sample_date] = LatestDate )

// in dim_unit
Status =
SWITCH ( dim_unit[Current Status],
    "Critical", UNICHAR ( 9632 ) & " Critical", "Caution", UNICHAR ( 9650 ) & " Caution",
    "Watch", UNICHAR ( 9679 ) & " Watch", "Normal", UNICHAR ( 10003 ) & " Normal" )

// in dim_unit
Unit and Status = dim_unit[unit_id] & "    " & dim_unit[Status]

// in dq_issues
Issue =
VAR t = SUBSTITUTE ( dq_issues[issue], "_", " " )
RETURN UPPER ( LEFT ( t, 1 ) ) & MID ( t, 2, 100 )

// in quarantine
Reason =
VAR t = SUBSTITUTE ( quarantine[reason], "_", " " )
RETURN UPPER ( LEFT ( t, 1 ) ) & MID ( t, 2, 100 )

// Sort by column: fact_samples[status] by [Status Order]; Date[Month Name] by [Month Start];
// dim_test[test] by [sort_order].
